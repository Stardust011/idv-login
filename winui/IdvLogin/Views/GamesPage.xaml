<Page
    x:Class="IdvLogin.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IdvLogin.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="游戏管理" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <Button Content="启动选中游戏" Command="{x:Bind ViewModel.StartGameCommand}"/>
            <Button Content="删除选中游戏" Command="{x:Bind ViewModel.RemoveGameCommand}"/>
        </StackPanel>

        <!-- 游戏列表 -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <StackPanel Margin="0,4,0,4">
                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Path}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 添加游戏路径输入 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
            <TextBox x:Name="ExePathBox" PlaceholderText="游戏可执行文件路径（.exe）"
                     Width="400"/>
            <Button Content="浏览…" Click="BrowseExe_Click"/>
            <Button Content="添加" Command="{x:Bind ViewModel.AddGameCommand}"
                    CommandParameter="{x:Bind ExePathBox.Text, Mode=OneWay}"/>
        </StackPanel>

        <!-- 状态栏 -->
        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.StatusMessage.Length, Mode=OneWay,
                          Converter={StaticResource NotEmptyToBoolConverter}}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 Severity="Informational"
                 IsClosable="True"/>
    </Grid>
</Page>
