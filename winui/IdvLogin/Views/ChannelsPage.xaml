<Page
    x:Class="IdvLogin.Views.ChannelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IdvLogin.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="账号管理" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}"/>
            <Button Content="删除选中账号" Command="{x:Bind ViewModel.DeleteChannelCommand}"/>
        </StackPanel>

        <!-- 账号列表 -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Channels, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Channel">
                    <StackPanel Margin="0,4,0,4">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind ChannelName}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 重命名 + 云同步 -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,8">
            <!-- 重命名 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="RenameBox" PlaceholderText="新账号名称" Width="240"/>
                <Button Content="重命名选中账号"
                        Command="{x:Bind ViewModel.RenameChannelCommand}"
                        CommandParameter="{x:Bind RenameBox.Text, Mode=OneWay}"/>
            </StackPanel>

            <!-- 云同步 -->
            <TextBlock Text="云端同步（使用 WebNote 服务，数据经 AES-256 加密）"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PasswordBox x:Name="MasterKeyBox"
                             PlaceholderText="主密钥（master key）"
                             Width="280"
                             Password="{x:Bind ViewModel.SyncMasterKey, Mode=TwoWay}"/>
                <Button Content="推送到云端"
                        Command="{x:Bind ViewModel.PushToCloudCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"/>
                <Button Content="从云端拉取"
                        Command="{x:Bind ViewModel.PullFromCloudCommand}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolNegConverter}}"/>
            </StackPanel>
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- 状态栏 -->
        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.StatusMessage.Length, Mode=OneWay, Converter={StaticResource NotEmptyToBoolConverter}}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 Severity="Informational"
                 IsClosable="True"/>
    </Grid>
</Page>
