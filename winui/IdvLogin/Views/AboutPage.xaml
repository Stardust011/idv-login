<Page
    x:Class="IdvLogin.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Margin="20" Spacing="12" MaxWidth="500">
        <TextBlock Text="关于" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="第五人格登录助手 (WinUI3)" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock TextWrapping="WrapWholeWords">
            <Run>Copyright © 2026 Alexander-Porter</Run>
        </TextBlock>
        <TextBlock TextWrapping="WrapWholeWords"
                   Text="本程序基于 GNU General Public License v3.0 开源。本工具仅供学习交流，请勿用于违规用途。"/>
        <HyperlinkButton Content="源码仓库（GitHub）"
                         NavigateUri="https://github.com/Alexander-Porter/idv-login"/>
        <HyperlinkButton Content="问题反馈"
                         NavigateUri="https://github.com/Alexander-Porter/idv-login/issues"/>
    </StackPanel>
</Page>
