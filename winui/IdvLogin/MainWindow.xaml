<Window
    x:Class="IdvLogin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:IdvLogin.Views"
    Title="第五人格登录助手">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="games" Icon="Home" Content="游戏管理"/>
                <NavigationViewItem Tag="channels" Icon="People" Content="账号管理"/>
                <NavigationViewItem Tag="settings" Icon="Setting" Content="设置"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="about" Icon="Help" Content="关于"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Margin="0,0,0,0"/>
        </NavigationView>
    </Grid>
</Window>
