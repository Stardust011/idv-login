<Application
    x:Class="IdvLogin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:IdvLogin.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局值转换器 -->
            <converters:BoolToVisibilityConverter    x:Key="BoolToVisibilityConverter"/>
            <converters:BoolNegVisibilityConverter   x:Key="BoolNegVisibilityConverter"/>
            <converters:BoolNegConverter             x:Key="BoolNegConverter"/>
            <converters:NotEmptyToBoolConverter      x:Key="NotEmptyToBoolConverter"/>
            <converters:CertStatusTextConverter      x:Key="CertStatusTextConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
